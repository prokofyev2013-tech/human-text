# Скопируйте файл в .env и заполните значения.
# Без ключа приложение работает в локальном режиме (структуратор на правилах).

# --- Ключ доступа к GigaChat (заполнить ОДИН из двух вариантов) -------------
# Вариант A. Готовый "Ключ авторизации" из личного кабинета (строка Base64).
LLM_API_KEY=
# Вариант B. Client ID и Client Secret по отдельности: приложение само
# соберёт из них Base64("id:secret"). Если заполнен LLM_API_KEY, эти поля
# игнорируются.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# --- Настройки модели -------------------------------------------------------
# Провайдер: gigachat
LLM_PROVIDER=gigachat
# Базовый URL API. Актуальный адрес с 17.07.2026 — https://api.giga.chat/v1
LLM_BASE_URL=https://api.giga.chat/v1
# Название модели: GigaChat-2-Max, GigaChat-2-Pro, GigaChat-3-Ultra (freemium)
LLM_MODEL=GigaChat-2-Max
# Таймаут одного запроса к модели, секунды.
LLM_TIMEOUT=30
# Количество повторных попыток при сбое.
LLM_MAX_RETRIES=2
# Температура генерации (0 — предсказуемо, 2 — хаотично).
LLM_TEMPERATURE=0.4

# OAuth-эндпоинт для получения токена доступа (живёт 30 минут).
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Версия API: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B, GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Проверка TLS-сертификата. У GigaChat собственный УЦ Минцифры,
# поэтому по умолчанию проверка отключена (false).
GIGACHAT_VERIFY_SSL=false

# --- Ограничения приложения -------------------------------------------------
# Ограничения ввода (знаки).
MIN_TEXT_LENGTH=10
MAX_TEXT_LENGTH=5000

# Ограничение частоты: запросов за окно (секунды).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# --- Бот сообщества ВКонтакте (Long Poll API) --------------------------------
# Сервисный токен сообщества (Управление → Настройки → Работа с API).
# Без него бот не запускается, приложение работает как обычно.
VK_API_TOKEN=
# ID сообщества (число, например 123456789).
VK_GROUP_ID=0
# Версия VK API.
VK_API_VERSION=5.199
# Куда слать уведомление о каждом запросе: peer_id вашего диалога с сообществом
# (например, 200000000000000123 или ваш user_id + 2000000000). Пусто — не слать.
VK_NOTIFY_PEER_ID=
# User ID администраторов через запятую: им доступны команды бота.
# Пусто — команды доступны всем, кто пишет сообществу.
VK_ADMIN_IDS=
# Отправлять уведомление на каждый запрос приложения (true/false).
VK_NOTIFY_EACH_REQUEST=true
